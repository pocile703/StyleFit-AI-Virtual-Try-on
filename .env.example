# Copy to `.env` (repo root) — docker compose reads it automatically.
# All optional: the stack runs locally with none of these set.

# Activates the real FASHN AI try-on engine. Unset = offline sharp mock composite.
# Get one at https://app.fashn.ai/api (needs billing credits).
FASHN_API_KEY=

# JWT signing secret. A dev fallback is used if unset — set a real value before
# any non-local deployment.
JWT_SECRET=

# Override the API base baked into the frontend. Leave blank for the default,
# which points the browser at <current-host>:4000 (works for localhost + LAN).
# Required in production, where the API lives on a different host entirely.
NEXT_PUBLIC_API_BASE=

# --- Production only -------------------------------------------------------
# Each of these switches one subsystem from its zero-setup local default to a
# hosted service. Leave them blank for local development.

# MongoDB Atlas connection string. Unset = backend/data/db.json on disk, which
# a hosting platform's ephemeral filesystem wipes on every restart.
MONGODB_URI=

# cloudinary://<api-key>:<api-secret>@<cloud-name>
# Unset = uploads and results are written to backend/uploads/, same problem.
CLOUDINARY_URL=

# Comma-separated sign-up invite codes. Empty = anyone can register, which is
# right locally and wrong on a public site whose try-on spends real credits.
SIGNUP_INVITE_CODES=

# Whole-deployment ceiling on try-ons per UTC day, on top of the per-user
# hourly limit. 0 or unset = no cap.
TRYON_DAILY_GLOBAL_CAP=

# Comma-separated allowlist of browser origins. Empty = reflect any origin,
# which is what local dev and phone-on-the-LAN testing need.
CORS_ORIGINS=
