# Copy to `.env` (repo root) — docker compose reads it automatically.
# All optional: the stack runs with none of these set.

# Activates the real FASHN AI try-on engine. Unset = offline sharp mock composite.
# Get one at https://app.fashn.ai/api (needs billing credits).
FASHN_API_KEY=

# JWT signing secret. A dev fallback is used if unset — set a real value before
# any non-local deployment.
JWT_SECRET=

# Override the API base baked into the frontend. Leave blank for the default,
# which points the browser at <current-host>:4000 (works for localhost + LAN).
NEXT_PUBLIC_API_BASE=
