# Copy to .env and fill in.

# FASHN AI virtual try-on API key — create one at https://app.fashn.ai/api
# With a key set, POST /api/tryon uses the real tryon-v1.6 model (1 credit/image).
# Without it, the endpoint falls back to the offline mock composite.
FASHN_API_KEY=

# Optional overrides
# PORT=4000
# JWT_SECRET=change-me-in-production
