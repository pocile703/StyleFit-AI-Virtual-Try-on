# Copy to .env and fill in.

# FASHN AI virtual try-on API key — create one at https://app.fashn.ai/api
# With a key set, POST /api/tryon uses the real models:
#   Standard quality -> tryon-v1.6  (1 credit/image)
#   High quality     -> tryon-max   (3 credits/image at 2k/balanced)
# Without it, the endpoint falls back to the offline mock composite.
FASHN_API_KEY=

# Optional overrides
# PORT=4000
# JWT_SECRET=change-me-in-production

# Per-user quotas. Try-on spends real credits, so keep this one tight.
# TRYON_RATE_LIMIT=20
# TRYON_RATE_WINDOW_MS=3600000
# UPLOAD_RATE_LIMIT=40
# UPLOAD_RATE_WINDOW_MS=3600000

# Comma-separated CORS allowlist. Leave empty in dev so LAN/phone access works.
# CORS_ORIGINS=https://stylefit.example.com
